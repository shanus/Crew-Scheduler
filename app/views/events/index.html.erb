<div class="row mb-4 align-items-center">
  <div class="col">
    <h1 class="display-4">Rowing Events List</h1>
    <p class="text-muted">A complete history of all scheduled rowing sessions.</p>
  </div>
  <div class="col-auto">
    <%= link_to new_event_path, class: "btn btn-success shadow-sm" do %>
      <i class="bi bi-calendar-plus"></i> New Event
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0">
  <%= render 'shared/list_events' %>
</div>

<div class="mt-4 d-flex justify-content-center">
  <%== @pagy.series_nav(:bootstrap) %>
</div>
