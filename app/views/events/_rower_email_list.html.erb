<ul class="list-group list-group-flush">
  <% 
    max_rowers = @event.boat&.max_number_of_rowers || 1
    (1..max_rowers).each do |i|
      # In the ported model, we use the seating_positions association
      seat_pos = @event.seating_positions.find_by(position: i)
      user = seat_pos&.user
      
      label = if max_rowers == 1
                "Single"
              elsif i == max_rowers
                "Stroke"
              elsif i == 1
                "Bow"
              else
                "Seat #{i}"
              end
  %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <span class="badge bg-secondary rounded-pill"><%= label %></span>
      <% if user %>
        <%= mail_to user.email, user.login, encode: "hex", class: "text-decoration-none fw-bold" %>
      <% else %>
        <span class="text-muted italic">Vacant</span>
      <% end %>
    </li>
  <% end %>
</ul>
