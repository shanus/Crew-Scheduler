<div class="row" data-controller="event-form">
  <div class="col-md-7">
    <% if @event.errors.any? %>
      <div class="alert alert-danger shadow-sm mb-4">
        <h5 class="alert-heading">Please correct the following errors:</h5>
        <ul class="mb-0">
          <% @event.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :team_id, "Crew", class: "form-label fw-bold" %>
      <%= f.collection_select :team_id, Team.order(:name), :id, :name, { prompt: "Select a Crew" }, { class: "form-select shadow-sm" } %>
    </div>

    <div class="row mb-3">
      <div class="col-md-12 mb-3">
        <%= f.label :event_on, "Date", class: "form-label fw-bold" %>
        <%= f.date_field :event_on, class: "form-control shadow-sm", data: { action: "change->event-form#updateTides" } %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :start_time, "Start Time", class: "form-label fw-bold" %>
        <%= f.time_field :start_time, class: "form-control shadow-sm", data: { action: "change->event-form#checkAvailability" } %>
      </div>
      <div class="col-md-6 mb-3">
        <%= f.label :end_time, "End Time", class: "form-label fw-bold" %>
        <%= f.time_field :end_time, class: "form-control shadow-sm", data: { action: "change->event-form#checkAvailability" } %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :boat_id, "Boat", class: "form-label fw-bold" %>
      <%= f.collection_select :boat_id, Boat.order(:name), :id, :name, { prompt: "Select a Boat" }, { class: "form-select shadow-sm", data: { action: "change->event-form#boatChanged" } } %>
    </div>

    <div id="boat_message" class="alert alert-warning d-none shadow-sm mb-3"></div>
    <div id="time_message" class="alert alert-info d-none shadow-sm mb-3"></div>

    <div id="boat_detail" class="mt-4 p-3 border bg-light shadow-sm d-none">
      <%# Will be populated via JS %>
    </div>
  </div>

  <div class="col-md-5">
    <div class="card shadow-sm border-0 bg-light">
      <div class="card-header bg-secondary text-white">
        <h5 class="mb-0"><i class="bi bi-water"></i> Relevant Tides</h5>
      </div>
      <div class="card-body p-0">
        <ul id="tide_summary" class="list-group list-group-flush">
          <%= render partial: 'shared/tide', collection: @tides, locals: { show_date: true } %>
        </ul>
      </div>
      <div class="card-footer bg-white border-top-0">
        <%= render partial: 'shared/tide_calendar' %>
      </div>
    </div>
    
    <div class="mt-4">
      <div class="alert alert-info small border-info">
        <h6 class="alert-heading"><i class="bi bi-info-circle"></i> Availability Check</h6>
        Selecting a boat, date, and time will automatically check for conflicts and relevant tides.
      </div>
    </div>
  </div>
</div>
