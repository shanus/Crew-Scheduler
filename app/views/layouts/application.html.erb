<!DOCTYPE html>
<html>
<head>
  <title><%= page_title %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Rowing Scheduler, a web based scheduling application to help clubs form boats and inform their members about availability.">
  <meta name="keywords" content="rowing, sculling, row, crew, scheduling, club">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= render 'layouts/favicons' %>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <%= yield(:head) %>
</head>

<body data-controller="theme">
  <nav class="navbar sticky-top navbar-expand-lg bg-primary text-bg-primary"data-bs-theme="dark">
    <div class="container-fluid">
      <%= link_to  root_path, title: "Crew Scheduler",class: "navbar-brand" do %>
        <%= image_tag 'icon_small.png', alt: 'YRC Logo', style: "max-height: 40px;" %> 
        <span class="d-inline d-lg-none">Crew Scheduler</span>
      <% end %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMain">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <% if logged_in? %>
            <li class="nav-item">
              <%= link_to "Summary", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
            </li>
            
            <% if @active_teams %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Crews
              </a>
              <ul class="dropdown-menu">
                <% @active_teams&.each do |team| %>
                <li class="dropdown-item">
                  <%= link_to team.name.titleize, summary_team_path(team), class: "nav-link #{'active' if @current_team == team}" %>
                </li>
              <% end %>
              </ul>
            </li>
            <% end %>

            <li class="nav-item">
              <%= link_to "Reports", reports_path, class: "nav-link #{'active' if controller_name == 'reports'}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Admin", admin_path, class: "nav-link #{'active' if controller_name == 'admin'}" %>
            </li>
          <% end %>
        </ul>

        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
          <% if logged_in? %>
            <li class="nav-item">
              <%= link_to edit_user_path(current_user), class: "nav-link me-2", title: "Edit Personal Settings" do %>
                <i class="bi bi-person-fill"></i> <%= current_user.login %>
              <% end %>
            </li>
            <li class="nav-item">
              <%= link_to logout_path, class: "nav-link", title: "Logout" do %>
                <i class="bi bi-box-arrow-right"></i> <span class="d-inline d-lg-none">Logout</span>
              <% end %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "Signup", signup_path, class: "btn btn-outline-light btn-sm me-2 my-2 my-lg-0" %>
            </li>
            <li class="nav-item">
              <%= link_to "Login", login_path, class: "btn btn-outline-light btn-sm me-2 my-2 my-lg-0" %>
            </li>
          <% end %>
          <li class="nav-item">
            <button class="nav-link ps-lg-2" data-action="click->theme#toggle" title="Toggle Dark Mode">
              <i class="bi bi-sun-fill" data-theme-target="icon"></i> <span class="d-inline d-lg-none">Toggle Dark Mode</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid pt-4">
    <%= render 'layouts/flash_messages' %>

    <%= yield %>
  </div>

  <footer class="container-fluid text-center mt-5 mb-3 text-muted fs-6">
    <hr>
    <p>Originally Created for <a href="http://www.yarmouth-rowing.org" target="_blank">Yarmouth Rowing Club</a>.</p>
    <p>
      <a rel="license" href="http://creativecommons.org/licenses/by-nc/3.0/" target="_blank">
        <img alt="Creative Commons License" style="border-width:0" src="https://i.creativecommons.org/l/by-nc/3.0/80x15.png" />
      </a>
      <br>This work is licensed under a <a rel="license" href="http://creativecommons.org/licenses/by-nc/3.0/" target="_blank">Creative Commons Attribution-Noncommercial 3.0 License</a>.
    </p>
  </footer>
</body>
</html>
