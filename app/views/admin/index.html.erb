<div class="row">
  <div class="col-lg-3">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0">Administration</h5>
      </div>
      <div class="list-group list-group-flush">
        <a href="#crews" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
          Crews <span class="badge bg-secondary rounded-pill"><%= Team.count %></span>
        </a>
        <a href="#boats" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
          Boats <span class="badge bg-secondary rounded-pill"><%= Boat.count %></span>
        </a>
        <a href="#rowers" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
          Rowers <span class="badge bg-secondary rounded-pill"><%= User.count %></span>
        </a>
        <%= link_to "Rowing Times", events_path, class: "list-group-item list-group-item-action" %>
      </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 bg-light">
      <div class="card-body">
        <h6 class="card-title fw-bold border-bottom pb-2">Admin Tools</h6>
        <div class="d-grid gap-2 mt-3">
          <%= link_to bulletins_path, class: "btn btn-sm btn-outline-primary text-start" do %>
            <i class="bi bi-megaphone"></i> Manage Bulletins
          <% end %>
          <%= link_to reports_path, class: "btn btn-sm btn-outline-primary text-start" do %>
            <i class="bi bi-bar-chart"></i> View Reports
          <% end %>
          <%= link_to tides_path, class: "btn btn-sm btn-outline-primary text-start" do %>
            <i class="bi bi-calendar3"></i> Tide Calendar
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-9">
    <div id="top" class="mb-5">
      <h1 class="display-5 mb-4">Scheduler Administration</h1>
      <p class="lead text-muted">Manage all aspects of the club schedule, equipment, and members.</p>
    </div>

    <section id="crews" class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0">Crews</h2>
        <%= link_to new_team_path, class: "btn btn-sm btn-success" do %>
          <i class="bi bi-plus-circle"></i> Add Crew
        <% end %>
      </div>
      <div class="card border-0 shadow-sm">
        <%= render partial: 'shared/list_crews' %>
      </div>
    </section>

    <section id="boats" class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0">Boats</h2>
        <%= link_to new_boat_path, class: "btn btn-sm btn-success" do %>
          <i class="bi bi-plus-circle"></i> Add Boat
        <% end %>
      </div>
      <div class="card border-0 shadow-sm">
        <%= render partial: 'shared/list_boats' %>
      </div>
    </section>

    <section id="rowers" class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0">Rowers</h2>
        <%= link_to signup_path, class: "btn btn-sm btn-success" do %>
          <i class="bi bi-person-plus"></i> Add Rower
        <% end %>
      </div>
      <div class="card border-0 shadow-sm">
        <%= render partial: 'shared/list_users' %>
      </div>
    </section>

    <div class="text-center py-4 text-muted">
      <%= link_to "Back to Top", "#top", class: "btn btn-link btn-sm text-decoration-none" %>
    </div>
  </div>
</div>
