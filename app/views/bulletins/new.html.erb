<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-success text-white p-3">
        <h2 class="h4 mb-0">Post New Bulletin</h2>
      </div>
      <div class="card-body p-4">
        <%= form_with(model: @bulletin, local: true) do |f| %>
          <%= render 'form', f: f %>
          <div class="mt-4 pt-3 border-top d-flex justify-content-between">
            <%= link_to 'Cancel', bulletins_path, class: "btn btn-outline-secondary" %>
            <%= f.submit 'Post Bulletin', class: "btn btn-success btn-lg px-5 shadow-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
