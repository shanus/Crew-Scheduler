<% if @bulletin.errors.any? %>
  <div class="alert alert-danger shadow-sm mb-4">
    <h5 class="alert-heading">Errors prevented this bulletin from being saved:</h5>
    <ul class="mb-0 fs-5">
      <% @bulletin.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mb-4">
  <%= f.label :title, class: "form-label fw-bold" %>
  <%= f.text_field :title, class: "form-control form-control-lg shadow-sm", placeholder: "Enter a descriptive title" %>
</div>

<div class="mb-4">
  <%= f.label :body, "Message Content", class: "form-label fw-bold" %>
  <%= f.text_area :body, rows: 10, class: "form-control shadow-sm", placeholder: "Type your announcement here... (Markdown supported)" %>
  <div class="form-text mt-2">
    <i class="bi bi-info-circle"></i> Supports <strong>Markdown</strong> formatting. 
    <a href="https://www.markdownguide.org/basic-syntax/" target="_blank" class="text-decoration-none ms-1">Markdown Cheat Sheet</a>
  </div>
</div>

<div class="mb-3">
  <%= f.label :display_until, "Show Bulletin Until", class: "form-label fw-bold" %>
  <div class="row">
    <div class="col-md-4">
      <%= f.date_field :display_until, class: "form-control shadow-sm" %>
    </div>
    <div class="col-md-8 pt-2">
      <span class="text-muted fs-5">The bulletin will automatically be hidden after this date.</span>
    </div>
  </div>
</div>
