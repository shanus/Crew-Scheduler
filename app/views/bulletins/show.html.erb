<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card shadow-lg border-0 overflow-hidden">
      <div class="card-header bg-dark text-white p-4">
        <div class="d-flex justify-content-between align-items-center">
          <h1 class="h3 mb-0">Bulletin</h1>
          <span class="badge bg-warning text-dark px-3 py-2">
            Visible until <%= human_date(@bulletin.display_until) %>
          </span>
        </div>
      </div>
      
      <div class="card-body p-4">
        <h2 class="h4 border-bottom pb-3 mb-4"><%= @bulletin.title %></h2>
        
        <div class="bulletin-content mb-5 p-3 bg-light shadow-sm border">
          <%= markdown @bulletin.body %>
        </div>
        
        <div class="row text-muted small border-top pt-4">
          <div class="col-sm-6">
            <div><strong>Posted by:</strong> <%= @bulletin.user.login %></div>
            <div class="mt-1"><strong>Email:</strong> <%= mail_to @bulletin.user.email %></div>
          </div>
          <div class="col-sm-6 text-sm-end">
            <div><strong>Created:</strong> <%= @bulletin.created_at.strftime("%B %d, %Y %H:%M") %></div>
            <div><strong>Last Updated:</strong> <%= @bulletin.updated_at.strftime("%B %d, %Y %H:%M") %></div>
          </div>
        </div>

        <div class="d-flex justify-content-between mt-5">
          <%= link_to bulletins_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left"></i> Back to All Bulletins
          <% end %>
          
          <% if current_user == @bulletin.user %>
            <%= link_to edit_bulletin_path(@bulletin), class: "btn btn-primary px-4 shadow-sm" do %>
              <i class="bi bi-pencil"></i> Edit Bulletin
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
