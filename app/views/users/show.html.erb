<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h3 class="mb-0">
            <i class="bi bi-person-circle"></i> Profile: <%= @user.login %>
          </h3>
          <% if @user.color.present? %>
            <span class="badge rounded-pill border border-white" style="background-color: <%= @user.color %>">
              Preferred Color
            </span>
          <% end %>
        </div>
        <div class="card-body">
          <div class="row mb-4">
            <div class="col-md-3 text-center">
              <div class="display-1 text-primary">
                <% case @user.side %>
                <% when 'port' %>
                  <i class="bi bi-arrow-left-circle-fill" title="Port"></i>
                <% when 'stbd' %>
                  <i class="bi bi-arrow-right-circle-fill" title="Starboard"></i>
                <% else %>
                  <i class="bi bi-arrow-left-right" title="Either"></i>
                <% end %>
              </div>
              <div class="fw-bold text-uppercase small"><%= @user.side %></div>
            </div>
            <div class="col-md-9">
              <h4 class="border-bottom pb-2">Details</h4>
              <ul class="list-unstyled">
                <li class="mb-2"><strong>Email:</strong> <%= mail_to @user.email, @user.email, class: "text-decoration-none" %></li>
                <li class="mb-2"><strong>Crew:</strong> <%= @user.team&.name || '<span class="text-muted">None</span>'.html_safe %></li>
                <li class="mb-2"><strong>Time Zone:</strong> <%= @user.time_zone %></li>
              </ul>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <h5 class="border-bottom pb-2">Preferences</h5>
              <ul class="list-unstyled">
                <li class="mb-2">
                  <i class="bi bi-<%= @user.will_cox ? 'check-circle-fill text-success' : 'dash-circle text-muted' %>"></i>
                  Willing to Coxswain
                </li>
                <li class="mb-2">
                  <i class="bi bi-<%= @user.will_coach ? 'check-circle-fill text-success' : 'dash-circle text-muted' %>"></i>
                  Willing to Coach
                </li>
              </ul>
            </div>
            <div class="col-md-6">
              <h5 class="border-bottom pb-2">Settings</h5>
              <ul class="list-unstyled">
                <li class="mb-2">
                  <i class="bi bi-<%= @user.send_reminders ? 'check-circle-fill text-success' : 'dash-circle text-muted' %>"></i>
                  Email Reminders
                </li>
                <li class="mb-2">
                  <i class="bi bi-<%= @user.public_rowing_history ? 'check-circle-fill text-success' : 'dash-circle text-muted' %>"></i>
                  Public History
                </li>
              </ul>
            </div>
          </div>

          <hr>

          <div class="row text-muted small">
            <div class="col-md-4">
              <strong>Created:</strong><br>
              <%= @user.created_at&.strftime("%B %e, %Y") || "N/A" %>
            </div>
            <div class="col-md-4">
              <strong>Last Updated:</strong><br>
              <%= @user.updated_at&.strftime("%B %e, %Y") || "N/A" %>
            </div>
            <div class="col-md-4">
              <strong>Activated:</strong><br>
              <%= @user.activated_at&.strftime("%B %e, %Y") || "<i>Not activated</i>".html_safe %>
            </div>
          </div>
        </div>
        <div class="card-footer bg-light text-end">
          <%= link_to edit_user_path(@user), class: "btn btn-primary" do %>
            <i class="bi bi-pencil"></i> Edit Profile
          <% end %>
          <%= link_to admin_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-list"></i> List All
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
