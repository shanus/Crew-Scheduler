<div class="row justify-content-center py-4">
  <div class="col-md-6">
    <div class="card shadow-lg border-0">
      <div class="card-header bg-success text-white text-center py-4">
        <h2 class="h4 mb-0">Join the Crew</h2>
        <p class="small mb-0 opacity-75">Sign up to start rowing with Yarmouth Rowing Club</p>
      </div>
      <div class="card-body p-4">
        <% if @user&.errors&.any? %>
          <div class="alert alert-danger shadow-sm">
            <h6 class="alert-heading">Validation Errors:</h6>
            <ul class="mb-0 small">
              <% @user.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with(model: @user, url: signup_path, local: true) do |f| %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :login, "Username", class: "form-label fw-bold" %>
              <%= f.text_field :login, class: "form-control shadow-sm", placeholder: "Pick a login name" %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :email, "Email Address", class: "form-label fw-bold" %>
              <%= f.email_field :email, class: "form-control shadow-sm", placeholder: "you@example.com" %>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :password, class: "form-label fw-bold" %>
              <%= f.password_field :password, class: "form-control shadow-sm" %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :password_confirmation, "Confirm Password", class: "form-label fw-bold" %>
              <%= f.password_field :password_confirmation, class: "form-control shadow-sm" %>
            </div>
          </div>

          <%# Modern Bot Protection - Invisible to Users %>
          <%= f.invisible_captcha :subtitle %>

          <div class="mt-4 pt-3 border-top">
            <div class="d-grid">
              <%= f.submit "Sign Up", class: "btn btn-success btn-lg shadow-sm" %>
            </div>
            <div class="text-center mt-3">
              <span class="text-muted small">Already have an account?</span>
              <%= link_to "Log In", login_path, class: "small text-decoration-none ms-1 fw-bold" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
