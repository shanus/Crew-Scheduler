<div class="list-group-item d-flex justify-content-between align-items-center">
  <div>
    <span class="badge" style="background-color: <%= tomorrow.team.color || '#6c757d' %>"><%= tomorrow.team.name.titleize %></span>
    in <strong><%= tomorrow.boat.name %></strong>
    <span class="text-muted ms-2"><%= human_time tomorrow.start_time %> - <%= human_time tomorrow.end_time %></span>
  </div>
  <%= link_to event_path(tomorrow), class: "btn btn-sm btn-link" do %>
    <i class="bi bi-eye"></i> View
  <% end %>
</div>
