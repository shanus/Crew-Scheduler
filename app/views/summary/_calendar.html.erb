<div class="mt-4 pt-3 border-top text-center">
  <div class="ratio ratio-4x3 shadow-sm border overflow-hidden mb-2">
    <iframe src="https://www.google.com/calendar/embed?title=YRC%20Event%20Calendar&amp;showDate=0&amp;showTabs=0&amp;showCalendars=0&amp;mode=AGENDA&amp;height=330&amp;wkst=1&amp;bgcolor=%23FFFFFF&amp;src=scheduler@yarmouth-rowing.org&amp;color=%232952A3&amp;ctz=America%2FNew_York" style="border-width:0" frameborder="0" scrolling="no">
    </iframe>
  </div>
  <%= link_to CrewScheduler::EVENT_CALENDAR || "#", target: "_blank", class: "btn btn-sm btn-link text-decoration-none", title: "Opens calendar in a new window" do %>
