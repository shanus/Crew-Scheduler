<%# legacy views used 'needed' as the local variable %>
<div class="list-group-item d-flex justify-content-between align-items-center mb-1 border-start border-4 border-danger shadow-sm">
  <div class="ms-2">
    The <strong><%= needed.team.name.titleize %></strong> Crew 
    needs <span class="badge bg-warning text-dark border"><%= seats_needed(needed) %></span>
    in the <strong><%= needed.boat.name %></strong>
    <div class="text-muted small mt-1">
      <i class="bi bi-calendar-event"></i> <%= human_date(needed.event_on, format: "%A, %m/%d") %> 
      <i class="bi bi-clock ms-2"></i> <%= human_time needed.start_time %> - <%= human_time needed.end_time %>
    </div>
  </div>
  <%= link_to summary_team_path(needed.team), class: "btn btn-outline-danger btn-sm" do %>
    Sign up <i class="bi bi-arrow-right-short"></i>
  <% end %>
</div>
