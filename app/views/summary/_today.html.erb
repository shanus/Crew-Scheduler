<div class="list-group-item d-flex justify-content-between align-items-center">
  <div>
    <span class="badge" style="background-color: <%= today.team.color || '#6c757d' %>"><%= today.team.name.titleize %></span>
    in <strong><%= today.boat.name %></strong>
    <span class="text-muted ms-2"><%= human_time today.start_time %> - <%= human_time today.end_time %></span>
  </div>
  <%= link_to event_path(today), class: "btn btn-sm btn-link" do %>
    <i class="bi bi-eye"></i> View
  <% end %>
</div>
