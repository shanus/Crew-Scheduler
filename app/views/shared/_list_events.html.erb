<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-dark">
      <tr>
        <th>Date</th>
        <th>Team / Boat</th>
        <th>Crew Members</th>
        <th>Staff</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr class="<%= 'opacity-75 bg-light' if event.date < Date.today %>">
          <td>
            <div class="fw-bold"><%= human_date(event.date) %></div>
            <div class="fs-5 text-muted"><%= event.date.strftime("%A") %></div>
          </td>
          <td>
            <div class="d-flex align-items-center mb-1">
              <% if event.team %>
                <span class="badge me-2" style="background-color: <%= event.team.color || '#6c757d' %>">
                  <%= event.team.name %>
                </span>
              <% end %>
            </div>
            <% if event.boat %>
              <div class="fs-5 text-muted d-flex align-items-center">
                <%= boat_icon(event.boat) %>
                <span class="ms-1"><%= event.boat.name %></span>
              </div>
            <% end %>
          </td>
          <td class="fs-5">
             <% if event.seating_positions.any? %>
                <% event.seating_positions.includes(:user).each do |sp| %>
                  <div class="d-inline-block me-2 mb-1">
                    <span class="text-muted"><%= sp.position_name %>:</span>
                    <span class="fw-bold"><%= sp.user&.login || 'Empty' %></span>
                  </div>
                <% end %>
             <% else %>
                <span class="text-muted italic">No seating assigned</span>
             <% end %>
          </td>
          <td class="fs-5">
            <% if event.coxswain %>
              <div><span class="text-muted">Cox:</span> <strong><%= event.coxswain_name %></strong></div>
            <% end %>
            <% if event.coach %>
              <div><span class="text-muted">Coach:</span> <strong><%= event.coach_name %></strong></div>
            <% end %>
          </td>
          <td class="text-end">
            <div class="d-flex justify-content-end gap-2">
              <%= link_to event_path(event), class: "btn btn-sm btn-outline-primary", title: "View" do %>
                <i class="bi bi-eye"></i>
              <% end %>
              <%= link_to edit_event_path(event), class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
              <%= link_to event_path(event), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger", title: "Delete" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
