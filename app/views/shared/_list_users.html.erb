<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-dark">
      <tr>
        <th>Username</th>
        <th>Email</th>
        <th class="text-center">Side</th>
        <th>Crew</th>
        <th class="text-center">Cox / Coach</th>
        <th>Status</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <div class="fw-bold"><%= user.login %></div>
            <div class="sparkline-container mt-1" style="width: 100px;">
              <%= sparkline(user.rowing_history(12)) if user.public_rowing_history? %>
            </div>
          </td>
          <td class="fs-5 text-muted"><%= mail_to user.email, user.email, class: "text-decoration-none" %></td>
          <td class="text-center">
             <span class="badge bg-light text-dark border">
               <%= user.side.to_s.upcase %>
             </span>
          </td>
          <td>
            <%= user.team&.name&.truncate(15) || "--" %>
          </td>
          <td class="text-center">
            <% if user.will_cox %>
              <span class="badge bg-info text-dark" title="Coxswain">X</span>
            <% end %>
            <% if user.will_coach %>
              <span class="badge bg-warning text-dark" title="Coach">C</span>
            <% end %>
          </td>
          <td>
            <% if user.activated_at %>
              <span class="text-success fs-5"><i class="bi bi-check-circle"></i> Verified</span>
            <% else %>
              <%= link_to "Activate", "#", class: "btn btn-sm btn-outline-warning py-0 px-2" %>
            <% end %>
          </td>
          <td class="text-end">
            <div class="d-flex justify-content-end gap-2">
              <%= link_to edit_user_path(user), class: "btn btn-sm btn-outline-secondary", title: "Edit" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
              <%= link_to user_path(user), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger", title: "Delete" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
