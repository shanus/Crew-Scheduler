<div class="row mb-4 align-items-center">
  <div class="col">
    <h1 class="display-4">Tide Calendar</h1>
  </div>
  <div class="col-auto">
    <%= link_to upload_tides_path, class: "btn btn-outline-primary shadow-sm" do %>
      <i class="bi bi-file-earmark-arrow-up"></i> Upload Tide File
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th>Day / Time</th>
          <th>Tides and Events</th>
        </tr>
      </thead>
      <tbody>
        <% @tides.each do |tide| %>
          <tr class="<%= 'bg-light' if tide.day == Date.today %>">
            <td style="width: 200px;">
              <div class="fw-bold"><%= human_date(tide.day) %></div>
              <div class="small text-muted"><%= tide.day.strftime("%A") %></div>
            </td>
            <td>
              <%= render partial: 'shared/tide', locals: { tide: tide, show_date: false } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-4 d-flex justify-content-center">
  <%== @pagy.series_nav(:bootstrap) %>
</div>
