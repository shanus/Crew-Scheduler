<% content_for :head do %>
  <%# Passing autocomplete data to JS via data attributes is more modern %>
  <script type="text/javascript">
    window.schedulerData = <%= users_autocomplete_data.to_json.html_safe %>;
  </script>
<% end %>

<div class="row mb-4 align-items-center">
  <div class="col">
    <h1 class="display-4"><%= @current_team.name.titleize %> Crew Schedule</h1>
  </div>
  <div class="col-auto text-end">
    <%= link_to new_for_team_events_path(team: @current_team), class: "btn btn-primary" do %>
      <i class="bi bi-plus-circle"></i> Add Rowing Time
    <% end %>
  </div>
</div>

<div class="row">
  <div class="col-md-9">
    <div class="btn-group mb-4 shadow-sm" role="group">
      <%= link_to 'Future', summary_team_path(@current_team, time: 'future'), 
          class: "btn btn-outline-secondary #{'active' if params[:time] == 'future' || params[:time].blank?}" %>
      <%= link_to 'Past', summary_team_path(@current_team, time: 'past'), 
          class: "btn btn-outline-secondary #{'active' if params[:time] == 'past'}" %>
      <%= link_to 'All', summary_team_path(@current_team, time: 'all'), 
          class: "btn btn-outline-secondary #{'active' if params[:time] == 'all'}" %>
    </div>

    <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th style="width: 50px;"></th>
              <th>Date / Time</th>
              <th>Boat</th>
              <th>Rowers / Seats</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @events.each do |event| %>
              <% disabled = !event.within_time_limit? %>
              <tr>
                <td>
                  <i class="bi <%= event.is_on? ? 'bi-check-circle-fill text-success' : 'bi-dash-circle text-warning' %>" 
                     title="<%= event.is_on? ? 'Event is ON' : 'Needs more rowers' %>"></i>
                </td>
                <td>
                  <div class="fw-bold">
                    <%= link_to human_date(event.event_on, format: "%a %m/%d/%y"), event_path(event), class: "text-decoration-none" %>
                  </div>
                  <small class="text-muted"><%= human_time event.start_time %> - <%= human_time event.end_time %></small>
                </td>
                <td>
                  <span class="badge bg-info text-dark shadow-sm"><%= event.boat.name %></span>
                </td>
                <td>
                  <div class="small text-truncate" style="max-width: 250px;">
                    <% seats_txt = seats_needed(event) %>
                    <%= seats_txt.present? ? "Needed: #{seats_txt}" : "Full Boat" %>
                  </div>
                </td>
                <td>
                  <% if event.is_on? %>
                    <span class="badge bg-success">Confirmed</span>
                  <% else %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-2">
                    <%= link_to event_path(event), class: "btn btn-sm btn-outline-primary", title: "View seating" do %>
                      <i class="bi bi-people"></i>
                    <% end %>
                    <% unless disabled %>
                      <%= link_to edit_event_path(event), class: "btn btn-sm btn-outline-secondary", title: "Edit event" do %>
                        <i class="bi bi-pencil"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    
    <div class="mt-4 d-flex justify-content-center">
      <%== @pagy.series_nav(:bootstrap) %>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 bg-light mb-4">
      <div class="card-body">
        <h5 class="card-title border-bottom pb-2">Crew Details</h5>
        <%= render partial: "team_email" %>
        <h6 class="mt-3">Members:</h6>
        <div class="fs-5">
          <%= comma_list(@current_team) %>
        </div>
      </div>
    </div>
    
    <div class="card shadow-sm border-0 border-start border-primary border-4">
      <div class="card-body">
        <h6 class="card-title"><i class="bi bi-info-circle"></i> Quick Guide</h6>
        <p class="small text-muted">Click on a date to see the full seating chart and sign up for a seat. Rowing times are usually confirmed once all required seats are filled.</p>
      </div>
    </div>
  </div>
</div>
