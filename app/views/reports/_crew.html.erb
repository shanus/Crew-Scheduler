<% history = crew.rowing_history -%>
<div class="card shadow-sm mb-4 border-0 border-start border-4" style="border-color: <%= report_color(crew) %> !important;">
  <div class="card-body">
    <h5 class="card-title fw-bold"><%= crew.name %></h5>
    <% if history.any? { |v| v > 0 } %>
      <div class="mb-3">
        <% chart_data = Hash[get_weeks(history.size - 1).reverse.zip(history)] %>
        <%= line_chart chart_data, height: "150px", points: false, colors: [report_color(crew)], library: { scales: { x: { display: false }, y: { beginAtZero: true, ticks: { stepSize: 1 } } } } %>
      </div>
      <%= build_history_table(history) %>
    <% else %>
      <p class="text-muted small italic">No rowing history recorded for this crew.</p>
    <% end %>
  </div>
</div>
