<%= turbo_frame_tag "report_content" do %>
  <div class="text-start">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
      <h2 class="h4 mb-0">Rowing Breakdown for <strong><%= @user.login %></strong></h2>
      <span class="badge bg-primary fs-6">
        <i class="bi bi-water"></i> <%= pluralize(@events.size, 'time') %> on water
      </span>
    </div>

    <div class="row">
      <div class="col-lg-6 mb-4">
        <h5 class="mb-3 border-bottom pb-2">By Crew</h5>
        <% if @crew_breakdown.present? %>
          <div class="mb-3">
            <%= pie_chart @crew_breakdown, height: "250px", library: { title: { display: true, text: 'Events by Crew' } } %>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover border">
              <thead class="bg-light">
                <tr><th>Crew</th><th class="text-end">Times</th></tr>
              </thead>
              <tbody>
                <% @crew_breakdown.each do |crew_name, count| %>
                  <tr>
                    <td><%= crew_name %></td>
                    <td class="text-end"><span class="badge bg-secondary"><%= count %></span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small italic">No crew data available.</p>
        <% end %>
      </div>

      <div class="col-lg-6 mb-4">
        <h5 class="mb-3 border-bottom pb-2">By Boat</h5>
        <% if @boating_breakdown.present? %>
          <div class="mb-3">
            <%= pie_chart @boating_breakdown, height: "250px", colors: ["#0dcaf0", "#6610f2", "#6f42c1", "#d63384", "#dc3545"], library: { title: { display: true, text: 'Events by Boat' } } %>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover border">
              <thead class="bg-light">
                <tr><th>Boat</th><th class="text-end">Times</th></tr>
              </thead>
              <tbody>
                <% @boating_breakdown.each do |boat_name, count| %>
                  <tr>
                    <td><%= boat_name %></td>
                    <td class="text-end"><span class="badge bg-info text-dark"><%= count %></span></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small italic">No boat data available.</p>
        <% end %>
      </div>

      <div class="col-md-12 mb-4">
        <h5 class="mb-3 border-bottom pb-2">By Seat</h5>
        <% if @seating_breakdown.present? %>
          <div class="mb-4">
            <%= column_chart @seating_breakdown, height: "300px", colors: ["#212529"] %>
          </div>
          <div class="row">
            <% @seating_breakdown.each do |seat_name, count| %>
              <div class="col-md-3 mb-2">
                <div class="card bg-light border-0 py-2 px-3 shadow-sm d-flex flex-row justify-content-between align-items-center">
                  <span class="small fw-bold"><%= seat_name %></span>
                  <span class="badge bg-dark rounded-pill"><%= count %></span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted small italic">No seating data available.</p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
