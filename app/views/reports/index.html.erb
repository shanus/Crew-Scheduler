<div class="row">
  <div class="col-md-3">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0"><i class="bi bi-file-earmark-bar-graph"></i> Quick Reports</h5>
      </div>
      <div class="list-group list-group-flush" id="report-menu">
        <%= link_to my_rowing_breakdown_reports_path, 
            data: { turbo_frame: "report_content" }, 
            class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          My Rowing
          <i class="bi bi-chevron-right small text-muted"></i>
        <% end %>
        
        <%= link_to crew_history_reports_path, 
            data: { turbo_frame: "report_content" }, 
            class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          Crew History
          <i class="bi bi-chevron-right small text-muted"></i>
        <% end %>

        <%= link_to boat_utilization_reports_path, 
            data: { turbo_frame: "report_content" }, 
            class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          Boat Utilization
          <i class="bi bi-chevron-right small text-muted"></i>
        <% end %>

        <%= link_to rower_history_reports_path, 
            data: { turbo_frame: "report_content" }, 
            class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          Rower History
          <i class="bi bi-chevron-right small text-muted"></i>
        <% end %>
      </div>
    </div>
    
    <div class="alert alert-light border shadow-sm small">
      <i class="bi bi-info-circle"></i> Click a report to load it instantly without a page refresh.
    </div>
  </div>

  <div class="col-md-9">
    <div class="card shadow-sm border-0 min-vh-50">
      <div class="card-body p-4 text-center">
        <%= turbo_frame_tag "report_content" do %>
          <div class="py-5">
            <i class="bi bi-graph-up display-1 text-light mb-4 d-block"></i>
            <h3 class="text-muted">Select a report from the menu to get started</h3>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
