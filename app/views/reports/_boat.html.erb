<% history = boat.rowing_history(16) -%>
<div class="card shadow-sm mb-4 border-0 border-start border-4" style="border-color: <%= report_color(boat) %> !important;">
  <div class="card-body">
    <div class="d-flex align-items-center mb-2">
      <%= boat_icon(boat) %>
      <h5 class="card-title fw-bold mb-0 ms-2"><%= boat.name %></h5>
    </div>
    <% if history.any? { |v| v > 0 } %>
      <div class="mb-3">
        <% chart_data = Hash[get_weeks(history.size - 1).reverse.zip(history)] %>
        <%= line_chart chart_data, height: "150px", points: false, library: { scales: { x: { display: false }, y: { beginAtZero: true, ticks: { stepSize: 1 } } } } %>
      </div>
      <%= build_history_table(history) %>
    <% else %>
      <p class="text-muted small italic">No utilization data for this boat.</p>
    <% end %>
  </div>
</div>
