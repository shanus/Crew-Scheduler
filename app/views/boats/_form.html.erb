<% if @boat.errors.any? %>
  <div class="alert alert-danger shadow-sm mb-4">
    <h5 class="alert-heading">Please correct the following errors:</h5>
    <ul class="mb-0">
      <% @boat.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row align-items-start">
  <div class="col-md-8">
    <div class="mb-3">
      <%= f.label :name, class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control shadow-sm", placeholder: "e.g. Spirit of Yarmouth" %>
    </div>

    <div class="mb-3">
      <%= f.label :hull_type, "Boat Type", class: "form-label fw-bold" %>
      <%= f.select :hull_type, 
          grouped_options_for_select(
            HullType::HULL_OPTIONS.map { |o| 
              [o.name, o.options.map { |opt| [opt.name, opt.value] }] 
            }, 
            @boat.hull_type
          ), 
          { prompt: "Select Boat Type" }, 
          { class: "form-select shadow-sm" } %>
    </div>

    <div class="mb-3">
      <%= f.label :boat_usage_id, "Usage", class: "form-label fw-bold" %>
      <%= f.collection_select :boat_usage_id, BoatUsage.all, :id, :name, { prompt: "Select Usage" }, { class: "form-select shadow-sm" } %>
    </div>

    <div class="mb-3">
      <%= f.label :boat_weight_id, "Crew Weight", class: "form-label fw-bold" %>
      <%= f.collection_select :boat_weight_id, BoatWeight.all, :id, :name, { prompt: "Select Weight" }, { class: "form-select shadow-sm" } %>
    </div>

    <div class="mb-3">
      <%= f.label :color, "Report Color", class: "form-label fw-bold" %>
      <div class="d-flex align-items-center gap-2">
        <%= f.color_field :color, class: "form-control form-control-color shadow-sm", title: "Choose a color for reports" %>
        <span class="small text-muted">Used in schedule highlight and charts</span>
      </div>
    </div>
  </div>

  <div class="col-md-4 text-center">
    <div class="card bg-light border-0 py-4 shadow-sm mb-3">
      <div id="boat-preview-icon">
        <%= boat_icon(@boat) %>
      </div>
      <div class="mt-2 small text-muted">Boat Preview</div>
    </div>
  </div>
</div>
